                font-family: var(--font-display);
                color: white;
                text-transform: uppercase;
            }

            .et-hero-tabs h3 {
                font-size: 1rem;
                letter-spacing: 0.3rem;
                opacity: 0.8;
                font-family: var(--font-code);
                color: var(--gray-text);

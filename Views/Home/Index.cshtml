                        <p>Professional production services for events of every kind — from intimate gatherings to large-scale corporate productions.</p>
                    <a href="#contact" class="book-link">
                        <span class="linktext">Get a Quote Today</span>
                        <span class="arrow"><span></span></span>
                    </a>
                    </div>
                    
                </div>
                <div class="right-part">
                    <div class="service-image-panel">
                        <img class="service-img active" data-index="0" src="/images/carousel-audio.jpg" alt="Audio">
                        <img class="service-img" data-index="1" src="/images/carousel-audio.jpg" alt="Audio">
                        <img class="service-img" data-index="2" src="/images/carousel-lighting.jpg" alt="Lighting">
                        <img class="service-img" data-index="3" src="/images/carousel-pattern.jpg" alt="Visuals">
                        <img class="service-img" data-index="4" src="/images/ledscreens.jpeg" alt="LED Screens">
                        <img class="service-img" data-index="5" src="/images/carousel-livestream.jpg" alt="Livestreams">
                        <img class="service-img" data-index="6" src="/images/photography.jpg" alt="Photography">
                        <img class="service-img" data-index="7" src="/images/videography.jpg" alt="Videography">
                        <img class="service-img" data-index="8" src="/images/cold_sparks.jpg" alt="FX">
                        <img class="service-img" data-index="9" src="/images/Portfolio/CorporateConference.JPG" alt="It All">
                        <div class="service-image-overlay"></div>
                    </div>
                </div>
            </section>
        </main>

        <!-- HERO SECTION -->
@*         <section class="hero-section" id="hero">
            <div class="hero-content">

                <video autoplay muted loop playsinline class="hero-video">
                    <source src="~/videos/Kief Final Parrty (Landscape).mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </section> *@

        <!-- SERVICES SECTION -->

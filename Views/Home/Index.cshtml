    <style>
        /* Carousel Section */
        .carousel-section {
            padding: 100px 40px;
            background: linear-gradient(180deg, #1a1a1a 0%, var(--dark-bg) 100%);
            position: relative;
            overflow: hidden;
            background-color: #121212;

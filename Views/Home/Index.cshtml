            background-size: 40px 40px;
        }

        .carousel-container {
            width: 100%;
            max-width: 1200px;
            height: 25em;
            margin: 0px auto 0;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .carousel {
            position: relative;
            width: 100%;
            height: 100%;
            list-style: none;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .carousel .items {
                width: 600px;
                height: 381px;
                background: #333;
                transition: all 0.3s ease-in-out;
                overflow: hidden;
                position: absolute;
                border-radius: 10px;
                box-shadow: 0 20px 30px rgba(0,0,0,0.5);
                left: 50%;
                transform: translateX(-50%);
            }

                .carousel .items img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

                .carousel .items:hover img {
                    transform: scale(1.1);
                }

            .carousel .main-pos {
                z-index: 3000;
                box-shadow: 0 20px 40px rgba(0,0,0,0.8);
                border: 2px solid rgba(255,255,255,0.2);
                transform: translateX(-50%) scale(1);
                opacity: 1;
            }

            .carousel .left-pos {
                opacity: 0.7;
                z-index: 1000;
                transform: translateX(calc(-50% - 300px)) scale(0.8);
                filter: brightness(0.8);
            }

            .carousel .right-pos {
                opacity: 0.7;
                z-index: 1000;
                transform: translateX(calc(-50% + 300px)) scale(0.8);
                filter: brightness(0.8);
            }

            .carousel .back-pos {
                opacity: 0.2;
                transform: translateX(-50%) scale(0.5);
                filter: brightness(0.5);
                pointer-events: none;
                z-index: 500;
            }

        .carousel-controls {
            position: absolute;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            justify-content: center;
            gap: 20px;
            z-index: 4000;
        }

        .carousel-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            border: 2px solid rgba(255,255,255,0.3);
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .carousel-btn:hover {
                background: var(--primary-color);
                border-color: var(--primary-color);
                transform: scale(1.1);
            }

        /* Responsive adjustments */
        @@media screen and (max-width: 900px) {

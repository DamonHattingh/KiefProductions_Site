        }

        .carousel .right-pos {
            transform: translateX(calc(-50% + 180px)) scale(0.8);
        }

        .carousel-controls {
            bottom: -50px;
        }

        }


        /* ------------------------------------------------------------------------------------ */

        /* Carousel Tags and Overlays */
        .carousel-tag {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            z-index: 10;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .carousel-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.95));
            padding: 30px 20px 20px;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 5;
        }

            .carousel-overlay h3 {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.4rem;
                font-weight: 600;
                color: white;
                margin-bottom: 5px;
                transform: translateY(20px);
                opacity: 0;
                transition: all 0.4s ease 0.1s;
            }

            .carousel-overlay p {
                font-size: 0.9rem;
                color: var(--gray-text);
                line-height: 1.4;
                transform: translateY(20px);
                opacity: 0;
                transition: all 0.4s ease 0.2s;
            }

        /* Show overlay on hover for main positioned item */
        .carousel .main-pos:hover .carousel-overlay {
            transform: translateY(0);
        }

            .carousel .main-pos:hover .carousel-overlay h3,
            .carousel .main-pos:hover .carousel-overlay p {
                transform: translateY(0);
                opacity: 1;
            }

        /* Tag color variations - match your existing portfolio tags */
        .tag-audio {
            background: rgba(255, 62, 0, 0.9);
            color: white;
        }

        .tag-streaming {
            background: rgba(0, 168, 255, 0.9);
            color: white;
        }

        .tag-photo {
            background: rgba(76, 175, 80, 0.9);
            color: white;
        }

        .tag-lighting {
            background: rgba(255, 235, 59, 0.9);

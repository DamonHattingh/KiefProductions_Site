        /* INTRO ANIMATION SECTION */
        .intro-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--dark-bg);
            z-index: 10000;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: fadeOutIntro 0.5s ease forwards 3.5s;
            pointer-events: none;
        }

        .intro-logo-container {
            width: 200px;
            height: 200px;
            animation: expandLogo 3.5s cubic-bezier(0.7, 0, 0.3, 1) forwards;
            transform-origin: center;
            position: relative;
        }

        .intro-logo {
            width: 100%;
            height: 100%;
        }

        .intro-logo-shape {
            fill: transparent;
            stroke: white;
            stroke-width: 1;
            stroke-dasharray: 1000;
            stroke-dashoffset: 1000;
            animation: drawIntro 2s ease forwards, fillIntro 0.5s ease forwards 1.8s;
        }

        @@keyframes drawIntro {
            to

        {
            stroke-dashoffset: 0;
        }

        }

        @@keyframes fillIntro {
            to

        {
            fill: white;
            stroke: transparent;
        }

        }

        @@keyframes expandLogo {
            0%

        {
            width: 200px;
            height: 200px;
        }

        50% {
            width: 400px;
            height: 400px;
        }

        80% {
            width: 300px;
            height: 300px;
            opacity: 1;
        }

        100% {
            width: 0;
            height: 0;
            opacity: 0;
        }

        }

        @@keyframes fadeOutIntro {
            to

        {
            opacity: 0;
            visibility: hidden;
        }

        }

        .content-wrapper {
            opacity: 0;
            animation: revealContent 0.8s ease forwards 3.5s;
        }

        @@keyframes revealContent {
            to

        {
            opacity: 1;
        }

        }


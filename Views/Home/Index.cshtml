        .partner-cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .partner-card {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 20px 30px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
            background: #1a1a1a;
        }

            .partner-card::before {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.5) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.5) 75%, rgba(255,255,255,0.1) 100%);
                border-radius: 17px;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 1;
                pointer-events: none;
                animation: rotateGlow 3s linear infinite;
            }

            .partner-card:hover::before {
                opacity: 1;
            }

            .partner-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                border-radius: 15px;
                border: 2px solid transparent;
                background: white border-box;
                -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
                mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: destination-out;
                mask-composite: exclude;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 3;
                pointer-events: none;
            }

            .partner-card:hover::after {
                opacity: 1;
            }

        .partner-image, .partner-overlay {
            position: relative;
            z-index: 2;
        }

        @@keyframes rotateGlow {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .partner-image {
            position: relative;
            width: 100%;
            height: 400px;
            overflow: hidden;
        }

            .partner-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .partner-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;

            /* Create a pseudo-element for the glow effect */
            .partner-card::before {
                content: '';
                position: absolute;
                top: -2px;
                left: -2px;
                right: -2px;
                bottom: -2px;
                background: linear-gradient( 45deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.5) 25%, rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.5) 75%, rgba(255, 255, 255, 0.1) 100% );
                border-radius: 17px; /* Slightly larger than parent */
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 1;
                pointer-events: none;
                animation: rotateGlow 3s linear infinite;
            }

            /* Alternative simpler glow that definitely works */
            .partner-card:hover::before {
                opacity: 1;
            }

            /* Alternative: Simple border glow that always works */
            .partner-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                border-radius: 15px;
                border: 2px solid transparent;
                background: white border-box;
                -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
                mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: destination-out;
                mask-composite: exclude;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 3;
                pointer-events: none;
            }

            .partner-card:hover::after {
                opacity: 1;
            }

        /* Make sure card content is above effects */
        .partner-image,
        .partner-overlay {
            position: relative;
            z-index: 2;
        }

        /* Rotation animation for the glow */
        @@keyframes rotateGlow {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        .partner-image {

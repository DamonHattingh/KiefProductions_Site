            color: white;
        }

        .tag-vr {
            background: rgba(0, 188, 212, 0.9);
            color: white;
        }

        /* Ensure items have position relative for absolute positioning */
        .carousel .items {
            position: absolute;
            overflow: hidden; /* Keep this to contain the overlay */
        }

        /* Optional: Add a subtle scale effect on hover */
        .carousel .main-pos:hover img {
            transform: scale(1.1);
        }

        /* Make sure overlay doesn't show on non-main items */
        .carousel .left-pos .carousel-overlay,
        .carousel .right-pos .carousel-overlay,
        .carousel .back-pos .carousel-overlay {
            display: none;
        }

        /* Show overlay and zoom effect on main-pos items by default */
        .carousel .main-pos .carousel-overlay {
            transform: translateY(0); /* Always visible */
        }

            .carousel .main-pos .carousel-overlay h3,
            .carousel .main-pos .carousel-overlay p {
                transform: translateY(0);
                opacity: 1;
            }

        .carousel .main-pos img {
            transform: scale(1.1); /* Always zoomed */
        }

        /* Optional: Keep hover effects for enhanced interaction */
        .carousel .main-pos:hover img {
            transform: scale(1.15); /* Slight additional zoom on hover */
        }

        .carousel .main-pos:hover .carousel-overlay h3,
        .carousel .main-pos:hover .carousel-overlay p {
            /* Optional: add some highlight effect on hover */
            /* color: var(--primary-color); */
        }


        /* ---------------------------------------------------------------------------------- */

        .form__group {
            position: relative;
            padding: 15px 0 0;
            margin-top: 20px;
            margin-right: 20px;
        }

        .form__field {
            font-family: inherit;
            width: 100%;
            border: 0;
            border-bottom: 2px solid #9b9b9b;
            outline: 0;
            color: #fff;
            padding: 7px 0;
            background: transparent;
            transition: border-color 0.2s;
            padding-top: 15px;
        }

            /* placeholder */
            .form__field::placeholder {
                color: transparent;
            }

            /* label when placeholder shown */
            .form__field:placeholder-shown ~ .form__label {
                cursor: text;
                top: 20px;
            }

        .form__label {
            position: absolute;
            top: 0;
            display: block;
            transition: 0.2s;
            font-size: 1rem;
            color: #9b9b9b;
        }

        /* focus state */
        .form__field:focus ~ .form__label {
            position: absolute;
            top: 0;
            display: block;
            transition: 0.2s;
            color: white;
            font-weight: 700;
        }

        .form__field:focus {
            padding-top: 15px;
            font-weight: 700;
            border-width: 3px;
           border-color: white;
            border-image-slice: 1;
        }

        /* reset input */
        .form__field:required,
        .form__field:invalid {
            box-shadow: none;
        }


        .carousel-container {
            width: 100%;
            max-width: 1200px;
            height: 25em;
            margin: 0px auto 0;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .carousel {
            position: relative;
            width: 100%;
            height: 100%;
            list-style: none;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .carousel .items {
                width: 600px;
                height: 381px;
                background: #333;
                transition: all 0.3s ease-in-out;
                overflow: hidden;
                position: absolute;
                border-radius: 10px;
                box-shadow: 0 20px 30px rgba(0,0,0,0.5);
                left: 50%;
                transform: translateX(-50%);
            }

                .carousel .items img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

            .carousel .main-pos {
                z-index: 3000;
                box-shadow: 0 20px 40px rgba(0,0,0,0.8);
                border: 2px solid rgba(255,255,255,0.2);
                transform: translateX(-50%) scale(1);
                opacity: 1;
            }

            .carousel .left-pos {
                opacity: 0.7;
                z-index: 1000;
                transform: translateX(calc(-50% - 300px)) scale(0.8);
                filter: brightness(0.8);
            }

            .carousel .right-pos {
                opacity: 0.7;
                z-index: 1000;
                transform: translateX(calc(-50% + 300px)) scale(0.8);
                filter: brightness(0.8);
            }

            .carousel .back-pos {
                opacity: 0.2;
                transform: translateX(-50%) scale(0.5);
                filter: brightness(0.5);
                pointer-events: none;
                z-index: 500;
            }

        .carousel-controls {
            position: absolute;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            justify-content: center;
            gap: 20px;
            z-index: 4000;
        }

        .carousel-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            border: 2px solid rgba(255,255,255,0.3);
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .carousel-btn:hover {
                background: var(--primary-color);
                border-color: var(--primary-color);
                transform: scale(1.1);
            }

        .carousel-tag {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            z-index: 10;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .carousel-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.95));
            padding: 30px 20px 20px;
            z-index: 5;
        }

            .carousel-overlay h3 {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.4rem;
                font-weight: 600;
                color: white;
                margin-bottom: 5px;
                transition: all 0.4s ease 0.1s;
            }

            .carousel-overlay p {
                font-size: 0.9rem;
                color: var(--gray-text);
                line-height: 1.4;
                transition: all 0.4s ease 0.2s;
            }

        .carousel .left-pos .carousel-overlay, .carousel .right-pos .carousel-overlay, .carousel .back-pos .carousel-overlay {
            display: none;
        }

        .carousel .main-pos .carousel-overlay {
            transform: translateY(0);
        }

            .carousel .main-pos .carousel-overlay h3, .carousel .main-pos .carousel-overlay p {
                transform: translateY(0);
                opacity: 1;
            }

        .carousel .main-pos img {
            transform: scale(1.1);
        }

        .carousel .main-pos:hover img {
            transform: scale(1.15);
        }

        /* TAG COLORS */
        .tag-audio {
            background: rgba(255,62,0,0.9);
            color: white;
        }

        .tag-streaming {
            background: rgba(0,168,255,0.9);
            color: white;
        }

        .tag-photo {
            background: rgba(76,175,80,0.9);
            color: white;
        }

        .tag-lighting {
            background: rgba(255,235,59,0.9);
            color: #000;
        }

        .tag-visuals {
            background: rgba(156,39,176,0.9);
            color: white;
        }

        .tag-vr {
            background: rgba(0,188,212,0.9);
            color: white;
        }

        /* TESTIMONIALS */
        .testimonials-section {
            padding: 100px 40px;
            background: linear-gradient(180deg, var(--dark-bg) 0%, #1a1a1a 100%);
        }

        .testimonials-slider {
            max-width: 800px;
            margin: 60px auto 0;
            position: relative;
        }

        .testimonial {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            display: none;
        }

            .testimonial.active {
                display: block;
                animation: fadeIn 0.5s ease;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .client-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }

        .client-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: #fff;
            flex-shrink: 0;
        }

        /* CONTACT */
        .contact-section {
            padding: 100px 40px;
            text-align: center;
        }

        .form__group {
            position: relative;
            padding: 15px 0 0;
            margin-top: 20px;
            margin-right: 20px;
        }

        .form__field {
            font-family: inherit;
            width: 100%;
            border: 0;
            border-bottom: 2px solid #9b9b9b;
            outline: 0;
            color: #fff;
            padding: 7px 0;
            background: transparent;
            transition: border-color 0.2s;
            padding-top: 15px;
        }

            .form__field::placeholder {
                color: transparent;
            }

            .form__field:placeholder-shown ~ .form__label {
                cursor: text;
                top: 20px;
            }

        .form__label {
            position: absolute;
            top: 0;
            display: block;
            transition: 0.2s;
            font-size: 1rem;
            color: #9b9b9b;
        }

        .form__field:focus ~ .form__label {
            position: absolute;
            top: 0;
            display: block;
            transition: 0.2s;
            color: white;
            font-weight: 700;
        }

        .form__field:focus {
            padding-top: 15px;
            font-weight: 700;
            border-width: 3px;
            border-color: white;
            border-image-slice: 1;
        }

        .form__field:required, .form__field:invalid {
            box-shadow: none;
        }

        /* FOOTER */
        .footer {
            background: #111;
            padding: 60px 40px 30px;
            border-top: 1px solid #333;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-logo {
            width: 120px;
            margin-bottom: 20px;
        }

        .footer-heading {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.3rem;
            margin-bottom: 20px;
            color: white;
        }

        .footer-links {
            list-style: none;
        }

            .footer-links li {
                margin-bottom: 10px;
            }

            .footer-links a {
                color: var(--gray-text);
                text-decoration: none;
                transition: var(--transition);
            }

                .footer-links a:hover {
                    color: var(--primary-color);
                    padding-left: 5px;
                }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

            .social-links a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                background: var(--card-bg);
                border-radius: 50%;
                color: white;
                text-decoration: none;
                transition: var(--transition);
            }

                .social-links a:hover {
                    background: var(--primary-color);
                    transform: translateY(-3px);
                }

        .copyright {
            text-align: center;
            margin-top: 60px;
            padding-top: 30px;
            border-top: 1px solid #333;
            color: var(--gray-text);
            font-size: 0.9rem;
        }

        /* MISC */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

            .fade-in.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .loading {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--dark-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

            .loading.hidden {
                opacity: 0;
                pointer-events: none;
            }

        .spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(255,255,255,0.1);
            border-radius: 50%;
            border-top-color: var(--primary-color);
            animation: spin 1s ease-in-out infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* RESPONSIVE */
        @@media screen and (max-width: 1199px) {
            .bg-line {
                height: 68px;
            }

            .right-part {
                height: 400px;
                width: 400px;
            }

            .box {
                width: 118px;
                height: 118px;
                font-size: 12px;
            }

            .left-part p {
                font-size: 14px;
                line-height: 1.8;
                width: 85%;
            }

            .left-part h1 .text {
                height: auto;
            }

            .bg-dash-circle {
                width: 130px;
            }

            .bg-circle-h-line {
                width: 156px;
                height: 92px;
            }

            .book-link {
                font-size: 48px;
                gap: 24px;
            }

                .book-link .arrow {
                    height: 28px;
                    width: 28px;
                }
        }

        @@media screen and (max-width: 992px) {
            .company-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .company-description {
                padding-right: 0;
                text-align: center;
            }

            .company-stats {
                justify-content: center;
            }

            .partner-cards {
                max-width: 600px;
                margin: 0 auto;
            }
        }

        @@media screen and (max-width: 767px) {
            /* Keep side-by-side layout — right image fills behind, left overlaps */
            .info-section {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                padding: 0;
                height: 25vh;
                position: relative;
            }

            .right-part {
                position: absolute;
                right: 0;
                top: 0;
                bottom: 0;
                width: 75%;
                height: 100%;
                margin: 0;
                border-radius: 0;
                z-index: 0;
            }

            .left-part {
                position: relative;
                z-index: 2;
                padding: 20px 16px;
                margin-left: 0;
                flex: none;
                width: 70%;
            }

            .left-part h1 {
                font-size: clamp(42px, 11vw, 75px);
            }

            .left-part h1 .text {
                height: clamp(48px, 12.5vw, 84px);
                line-height: clamp(42px, 11vw, 75px);
            }

            .left-part h1 .d-flex {
                gap: 0.7rem;
            }

            .left-part p {
                font-size: 12px;
                width: 85%;
                text-shadow: 0 1px 4px rgba(0,0,0,0.8);
            }

            .book-link {
                font-size: 22px;
                gap: 12px;
                margin-top: 16px;
            }

            .book-link .arrow {
                height: 20px;
                width: 20px;
            }

            .bg-line { height: 52px; }
            .bg-dash-circle { width: 80px; }
            .bg-circle-h-line { width: 126px; height: 65px; }
        }

        @@media screen and (max-width: 480px) {
            .left-part h1 {
                font-size: clamp(36px, 10vw, 60px);
            }

            .left-part h1 .text {
                height: clamp(40px, 11vw, 68px);
                line-height: clamp(36px, 10vw, 60px);
            }

            .left-part h1 .d-flex {
                gap: 0.5rem;
            }

            .book-link {
                font-size: 18px;
                gap: 10px;
            }
        }

        /* MOBILE HAMBURGER + OVERLAY NAV */
        .mobile-hamburger {
            display: flex;
            width: 44px;
            height: 44px;
            background: rgba(10,10,10,0.9);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            backdrop-filter: blur(10px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
            padding: 0;
            z-index: 10001;
        }

        .mobile-hamburger.sticky {
            position: fixed;
            top: 12px;
            right: 16px;
        }

        .mobile-hamburger span {
            display: block;
            width: 20px;
            height: 2px;
            background: #fff;
            border-radius: 2px;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .mobile-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .mobile-hamburger.open span:nth-child(2) { opacity: 0; }
        .mobile-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .mobile-nav-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 99999;
            background: rgba(10,10,10,0.97);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .mobile-nav-overlay.open {
            display: flex;
        }

        .mobile-nav-overlay a {
            font-family: 'Bebas Neue', 'Oswald', 'Impact', sans-serif;
            font-size: 3rem;
            color: #ffffff !important;
            text-decoration: none !important;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: color 0.2s ease;
            padding: 8px 0;
            opacity: 0.7;
        }

        .mobile-nav-overlay a:hover { opacity: 1; }

        .nav-logo-mobile {
            display: none;
        }

        @@media (max-width: 768px) {
            .mobile-hamburger { display: flex; }

            .nav-logo-desktop { display: none; }

            .nav-logo-mobile {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                width: 100%;
                padding: 0 20px;
            }

            .et-hero-tabs {
                height: 11vh;
            }

            .et-hero-tabs-container {
                display: none !important;
            }

            .et-hero-tab-slider {
                display: none;
            }

            .hero-title {
                font-size: 2.5rem;
            }

            .hero-subtitle {
                font-size: 1.2rem;
            }

            .cta-buttons {
                flex-direction: column;
                align-items: center;
            }

            .section-title {
                font-size: 2.2rem;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .services-section, .testimonials-section, .contact-section {
                padding: 60px 20px;
            }

            .company-section {
                padding: 60px 20px;
            }

            .company-title {
                font-size: 2rem;
            }

            .company-stats {
                flex-direction: column;
                gap: 20px;
                align-items: center;
            }

            .stat-item {
                align-items: center;
            }

            .partner-cards {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .partner-image {
                height: 150px;
            }

            .partner-overlay {
                padding: 16px 10px 10px;
            }

            .partner-name {
                font-size: 0.85rem;
                margin-bottom: 3px;
            }

            .partner-role {
                font-size: 0.65rem;
                padding: 3px 8px;
                margin-bottom: 6px;
            }

            #contactForm {
                width: 95% !important;
            }

            #contactForm button[type="submit"] {
                width: 100% !important;
            }

            .form__group {
                margin-right: 0;
            }
        }

        @@media screen and (max-width: 900px) {
            .carousel .items {
                width: 400px;
                height: 225px;
            }

            .carousel .left-pos {
                transform: translateX(calc(-50% - 250px)) scale(0.8);
            }

            .carousel .right-pos {
                transform: translateX(calc(-50% + 250px)) scale(0.8);
            }
        }

        @@media screen and (max-width: 700px) {
            .carousel-container {
                height: 20em;
            }

            .carousel .items {
                width: 300px;
                height: 169px;
            }

            .carousel .left-pos {
                transform: translateX(calc(-50% - 180px)) scale(0.8);
            }

            .carousel .right-pos {
                transform: translateX(calc(-50% + 180px)) scale(0.8);
            }

            .carousel-controls {
                bottom: -50px;
            }
        }

        /* PROCESS SECTION */
        .process-section {
            padding: 80px 40px;
            background: linear-gradient(180deg, #1a1a1a 0%, var(--dark-bg) 100%);
        }

        .process-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            gap: 0;
        }

        .process-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            flex: 1;
            max-width: 180px;
            padding: 0 8px;
        }

        .process-icon-wrap {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: white;
            margin-bottom: 14px;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .process-step:hover .process-icon-wrap {
            background: rgba(255,255,255,0.1);
            transform: scale(1.1);
        }

        .process-step:nth-child(1) .process-icon-wrap {
            color: var(--primary-color);
            border-color: rgba(255,62,0,0.4);
        }

        .process-step:nth-child(3) .process-icon-wrap {
            color: var(--secondary-color);
            border-color: rgba(0,168,255,0.4);
        }

        .process-step:nth-child(5) .process-icon-wrap {
            color: var(--accent-color2);
            border-color: rgba(255,235,59,0.4);
        }

        .process-step:nth-child(7) .process-icon-wrap {
            color: #4CAF50;
            border-color: rgba(76,175,80,0.4);
        }

        .process-step:nth-child(9) .process-icon-wrap {
            color: var(--accent-color);
            border-color: rgba(156,39,176,0.4);
        }

        .process-step h3 {
            font-family: 'Montserrat', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            color: white;
            margin-bottom: 8px;
        }

        .process-step p {
            color: var(--gray-text);
            line-height: 1.6;
            font-size: 0.82rem;
        }

        .process-arrow {
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.2);
            font-size: 1rem;
            padding-top: 18px;
            flex-shrink: 0;
            align-self: flex-start;
            margin-top: 10px;
        }

        @@media (max-width: 900px) {
            .process-container {
                flex-wrap: wrap;
                gap: 30px;
                justify-content: center;
            }

            .process-step {
                max-width: 140px;
            }

            .process-arrow {
                display: none;
            }
        }

        @@media (max-width: 768px) {
            .process-section {
                padding: 60px 20px;
            }

            .process-step {
                max-width: 120px;
            }

                .process-step h3 {
                    font-size: 0.85rem;
                }

                .process-step p {
                    font-size: 0.75rem;
                }
        }

        .hero-video {
            max-width: 100%; /* Add this line */
            height: auto; /* Add this line */
            border-radius: 10px; /* Optional: add rounded corners */
            border: gray 5px solid;
        }

        @@media (max-width: 768px) {
            #top-section
        {
            display: none;
        }

        }
    </style>
</head>
<body>

    <!-- LOGO REVEAL ANIMATION -->
    <div class="intro-animation" id="introAnimation">
        <div class="intro-logo-container">
            <svg class="intro-logo" viewBox="0 0 110.32 113.94" xmlns="http://www.w3.org/2000/svg">
                <polygon class="intro-logo-shape" points="110.32 0 110.32 113.94 72.34 113.94 72.34 103.43 99.65 103.43 99.65 10.69 32.91 10.69 32.91 40.4 41.78 22.64 52.63 22.64 39.43 49.19 52.45 91.66 41.78 91.66 32.91 65.21 32.91 91.66 22.24 91.66 22.24 0 110.32 0" />
                <path class="intro-logo-shape" d="M18.45,0v10.69h-7.96l-.18,92.75h47.29l.27-.27V22.64h16.73c5.43,0,11.43,5.91,12.74,10.97,1,3.87.98,15.58-.44,19.28-1.82,4.72-7.61,9.6-12.84,9.6h-5.7v51.45H0V0h18.45ZM68.72,51.81h4.25c1.64,0,3.86-2.31,4.31-3.84.56-1.93.54-9.5-.19-11.34-.47-1.18-1.37-2.18-2.52-2.73-.2-.09-1.35-.57-1.42-.57h-4.43v18.48Z" />
            </svg>
        </div>
    </div>

    <!-- Content Wrapper -->
    <div class="content-wrapper">

        <!-- Loading Screen -->
        <div class="loading" id="loading">
            <div class="spinner"></div>
        </div>

        <!-- STICKY SLIDER NAV -->
        <section class="et-hero-tabs">
            <!-- Desktop: full logo. Mobile: short logo + hamburger side by side -->
            <img src="/images/Logo_White_Text.png" alt="Logo" class="nav-logo-desktop" style="width: 450px; max-width: 80vw; margin-bottom: 30px;" />
            <div class="nav-logo-mobile">
                <img src="/images/TextWhite.png" alt="Kief Productions" style="height: 70px; width: auto;" />
                <button class="mobile-hamburger" id="mobileHamburger" onclick="toggleMobileNav(this)" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>
            </div>
            <div class="et-hero-tabs-container">
                <a class="et-hero-tab" href="#home">Home</a>
                <a class="et-hero-tab" href="#services">Services</a>
                <a class="et-hero-tab" href="#carousel">Portfolio</a>
                <a class="et-hero-tab" href="#company">Who We Are</a>
                <a class="et-hero-tab" href="#testimonials">Testimonials</a>
                <a class="et-hero-tab" href="#contact">Contact</a>
                <span class="et-hero-tab-slider"></span>
            </div>
        </section>

        <!-- INFO SECTION -->
        <main>
            <section class="info-section" id="home">
                <div class="left-part">
                    <h1>
                        <span class="d-flex">
                            <span>we</span>
                            <span>Do</span>
                        </span>
                        <span class="text"></span>
                    </h1>
